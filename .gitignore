# =============================================================================
# SynFlow — .gitignore
# =============================================================================

# --- Secrets & environment (NEVER commit these) ---
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# --- Build outputs ---
dist/
build/
*.next/
out/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.installed.cfg
*.egg

# --- Docker (kept local only, never pushed) ---
.dockerignore
Dockerfile
Dockerfile.*
*.dockerfile
docker-compose.yml
docker-compose.yaml
compose.yml
compose.yaml
entrypoint.sh
docker/
.docker/

# --- IDE & OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Project-specific outputs ---
Result/
matched_experiments/
*.log

# --- Git ---
.git/

# --- Misc ---
*.pdf
*.xml
tripinfo_*.xml

# --- Deployment files that MUST be tracked for Render ---
!/.dockerignore
!/Synflow Complete Backend/Dockerfile
!/Synflow Complete Backend/server/package-lock.json

# --- SUMO runtime assets required by the simulation ---
!/Synflow Complete Backend/engine/SUMO/
!/Synflow Complete Backend/engine/SUMO/**
