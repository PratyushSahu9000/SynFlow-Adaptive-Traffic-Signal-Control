# =============================================================================
# SynFlow backend environment template
# Copy to `.env` locally (never commit it). On Render, set these as
# Environment Variables in the service dashboard.
# All values below are placeholders — no real credentials.
# =============================================================================

# Port the Express server listens on (Render injects PORT; default 10000).
PORT=10000

# MongoDB Atlas connection string. Fill in privately. NEVER commit this.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Python runner configuration (Docker/Render image paths).
# Local Windows example: PYTHON_CMD=E:\SynFlow\.venv\Scripts\python.exe
PYTHON_CMD=/opt/venv/bin/python
RUNNER_PATH=/app/engine/run_matched_experiment.py
RESULTS_DIR=/app/Result

# Comma-separated list of allowed browser origins for CORS.
# Example production value: https://your-frontend.onrender.com
FRONTEND_ORIGIN=http://localhost:5173

# Number of trusted reverse-proxy hops in front of Express.
# Render terminates TLS with one proxy: keep 1. Never use `true`.
TRUST_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# Public rate limits (visitor-friendly defaults)
# -----------------------------------------------------------------------------

# Ordinary API reads: 120 requests per IP per 15 minutes.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=120

# Experiment start cooldown: 1 start per IP per 2 minutes.
EXPERIMENT_IP_WINDOW_MS=120000
EXPERIMENT_IP_MAX=1

# Experiment starts per IP per hour.
EXPERIMENT_IP_HOURLY_WINDOW_MS=3600000
EXPERIMENT_IP_HOURLY_MAX=5

# Experiment starts per IP per 24 hours.
EXPERIMENT_IP_DAILY_WINDOW_MS=86400000
EXPERIMENT_IP_DAILY_MAX=10

# Global accepted starts per UTC day (persisted in MongoDB).
GLOBAL_DAILY_EXPERIMENT_LIMIT=25

# One simulation at a time, no waiting queue, 20 minute hard timeout.
MAX_CONCURRENT_EXPERIMENTS=1
EXPERIMENT_TIMEOUT_MS=1200000

# -----------------------------------------------------------------------------
# Server-Sent Events connection caps (heartbeat stays at 15 seconds)
# -----------------------------------------------------------------------------
SSE_MAX_PER_IP=2
SSE_MAX_TOTAL=50
SSE_HEARTBEAT_MS=15000
