# =============================================================================
# SynFlow backend environment template
# Copy to `.env` locally (never commit it). On Render, set these as
# Environment Variables in the service dashboard.
# All values below are placeholders — no real credentials.
# =============================================================================

# Port the Express server listens on (Render injects PORT; default 10000).
PORT=10000

# MongoDB Atlas connection string. Fill in privately. NEVER commit this.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Python runner configuration (Docker/Render image paths).
# Local Windows example: PYTHON_CMD=E:\SynFlow\.venv\Scripts\python.exe
PYTHON_CMD=/opt/venv/bin/python
RUNNER_PATH=/app/engine/run_matched_experiment.py
RESULTS_DIR=/app/Result

# Comma-separated list of allowed browser origins for CORS.
# Example production value: https://your-frontend.onrender.com
FRONTEND_ORIGIN=http://localhost:5173
